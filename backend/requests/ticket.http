# Replace currentTeamId with an existing team's ID.
@currentTeamId = 1
# Use a different existing team and an author belonging to currentTeamId.
@targetTeamId = 2
@authorId = 1

### Create a ticket (201 Created)
# @name createTicket
POST http://localhost:8080/api/tickets
Content-Type: application/json

{
    "title": "Experiment failed",
    "content": "Investigate the worker logs.",
    "currentTeamId": {{currentTeamId}}
}

### Fetch the created ticket (200 OK)
GET {{createTicket.response.headers.Location}}

### Unknown ticket (404 Not Found)
GET http://localhost:8080/api/tickets/0

### Unknown team (404 Not Found)
POST http://localhost:8080/api/tickets
Content-Type: application/json

{
    "title": "Demo",
    "content": "Content",
    "currentTeamId": 9223372036854775807
}

### Reject a blank title (400 Bad Request)
POST http://localhost:8080/api/tickets
Content-Type: application/json

{
    "title": "",
    "content": "Content",
    "currentTeamId": {{currentTeamId}}
}

### Close the created ticket (200 OK; use its current version)
POST {{createTicket.response.headers.Location}}/close
Content-Type: application/json

{
    "expectedVersion": 0
}

### Reopen the ticket after closing (200 OK)
POST {{createTicket.response.headers.Location}}/reopen
Content-Type: application/json

{
    "expectedVersion": 1
}

### Reject a stale version after reopening (409 Conflict)
POST {{createTicket.response.headers.Location}}/close
Content-Type: application/json

{
    "expectedVersion": 0
}

### Transfer the reopened ticket (200 OK; use its current version)
POST {{createTicket.response.headers.Location}}/transfer
Content-Type: application/json

{
    "targetTeamId": {{targetTeamId}},
    "authorId": {{authorId}},
    "comment": "Please investigate the worker logs.",
    "expectedVersion": 2
}
